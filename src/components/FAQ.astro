---
/**
 * Accessible FAQ accordion built on native <details>/<summary>:
 * keyboard and screen-reader support built in, works without JavaScript.
 */
import Icon from './Icon.astro';

interface Props {
  items: readonly { q: string; a: string; link?: { href: string; label: string } }[];
}
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary class="faq__q">
        <span class="faq__title">{item.q}</span>
        <span class="faq__icon"><Icon name="arrowDown" size={18} /></span>
      </summary>
      <div class="faq__a"><p>{item.a}{item.link && <>{' '}<a href={item.link.href} class="faq__link">{item.link.label}</a></>}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: var(--space-3); }
  .faq__link { color: var(--brand-blue); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .faq__item {
    background: var(--white);
    border: 1px solid var(--line-light);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .faq__item[open] { border-color: var(--blue-100); box-shadow: var(--shadow-sm); }
  .faq__q {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    border-radius: var(--radius);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:focus-visible { outline-color: var(--brand-blue); outline-offset: -3px; }
  .faq__title { font-family: var(--font-display); color: var(--ink); font-size: var(--text-base); font-weight: 700; line-height: 1.4; }
  .faq__icon {
    flex: none;
    display: grid; place-items: center;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--brand-blue);
    transition: transform 0.25s var(--ease);
  }
  .faq__item[open] .faq__icon { transform: rotate(180deg); }
  .faq__a { padding: 0 var(--space-5) var(--space-5); max-width: 70ch; }
</style>
