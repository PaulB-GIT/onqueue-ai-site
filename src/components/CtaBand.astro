---
/** Closing call-to-action band used at the end of inner pages. */
import Button from './Button.astro';
import { demoHref } from '../config/site';

interface Props {
  title: string;
  text?: string;
  secondary?: { label: string; href: string };
}
const { title, text, secondary } = Astro.props;
---
<section class="cta-band section--tight" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-band__panel surface-dark">
      <div class="tech-grid" aria-hidden="true"></div>
      <div class="cta-band__content">
        <h2 id="cta-band-title">{title}</h2>
        {text && <p class="lead">{text}</p>}
      </div>
      <div class="cta-band__actions">
        <Button href={demoHref} size="lg" icon="arrowRight">BOOK A DEMO</Button>
        {secondary && <Button href={secondary.href} variant="secondary" size="lg">{secondary.label}</Button>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band__panel {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse 70% 120% at 100% 0%, rgba(10, 72, 137, 0.7), transparent 60%),
      var(--brand-navy);
    border: 1px solid rgba(237, 191, 12, 0.25);
  }
  .cta-band__content { position: relative; max-width: 620px; }
  .cta-band__content h2 { margin-bottom: var(--space-3); }
  .cta-band__actions { position: relative; display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
