---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import VoiceInterface from '../components/VoiceInterface.astro';
import Conversation from '../components/Conversation.astro';
import ServiceShowcase from '../components/ServiceShowcase.astro';
import DemoRequest from '../components/DemoRequest.astro';
import { demoHref } from '../config/site';
import { meta, hero, services, conversation, industries, humanSupport } from '../data/home';
---
<BaseLayout title={meta.title} description={meta.description}>
  <!-- A: Hero -->
  <section class="hero surface-dark" aria-labelledby="hero-title">
    <div class="tech-grid" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 id="hero-title">
          <span class="hero__line">{hero.titleLine1}</span>
          <span class="hero__line hero__line--accent">{hero.titleLine2}</span>
        </h1>
        <p class="lead hero__text">{hero.text}</p>
        <div class="hero__actions">
          <Button href={demoHref} size="lg" icon="arrowRight">BOOK A DEMO</Button>
          <Button href="#services" variant="secondary" size="lg" icon="arrowDown">Explore Services</Button>
        </div>
      </div>
      <div class="hero__visual">
        <VoiceInterface />
      </div>
    </div>
  </section>

  <!-- B: Core services -->
  <section id="services" class="section surface-light" aria-labelledby="services-title">
    <div class="container">
      <SectionHeading id="services-title" eyebrow={services.eyebrow} title={services.title} intro={services.intro} />
      <div class="services-grid">
        {services.items.map((s) => <ServiceCard {...s} />)}
      </div>
      <p class="note services-note">{services.note}</p>
    </div>
  </section>

  <!-- B2: Sample calls showcase (clickable services, auto slideshow) -->
  <ServiceShowcase />

  <!-- C: Illustrative conversation -->
  <section class="section surface-dark convo-section" aria-labelledby="convo-title">
    <div class="tech-grid" aria-hidden="true"></div>
    <div class="container convo-section__inner">
      <div class="convo-section__copy">
        <SectionHeading id="convo-title" eyebrow={conversation.eyebrow} title={conversation.title} />
        <ul class="convo-points">
          {conversation.points.map((p) => (
            <li>
              <span class="convo-points__icon"><Icon name={p.icon} size={22} /></span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <Conversation label={conversation.label} turns={conversation.turns} />
    </div>
  </section>

  <!-- D: Industries -->
  <section class="section surface-white" aria-labelledby="industries-title">
    <div class="container">
      <SectionHeading id="industries-title" eyebrow={industries.eyebrow} title={industries.title} intro={industries.intro} />
      <ul class="industries">
        {industries.items.map((item) => (
          <li class="industry">
            <span class="industry__icon"><Icon name={item.icon} size={24} /></span>
            <h3>{item.title}</h3>
            <p><span class="industry__label">Example application:</span> {item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- E: AI + human support -->
  <section class="section surface-tint" aria-labelledby="human-title">
    <div class="container human">
      <div class="human__diagram" aria-hidden="true">
        <svg viewBox="0 0 420 300" focusable="false">
          <defs>
            <linearGradient id="hs-line" x1="0" x2="1">
              <stop offset="0" stop-color="#0A4889" stop-opacity=".25" />
              <stop offset="1" stop-color="#0A4889" stop-opacity=".9" />
            </linearGradient>
          </defs>
          <g fill="none" stroke="url(#hs-line)" stroke-width="2">
            <path d="M90 150 H170" />
            <path d="M250 150 C 290 150, 290 80, 330 80" />
            <path d="M250 150 C 290 150, 290 220, 330 220" />
          </g>
          <g fill="#fff" stroke="#DBE7F5" stroke-width="1.5">
            <rect x="20" y="115" width="70" height="70" rx="16" />
            <rect x="170" y="110" width="80" height="80" rx="40" />
            <rect x="330" y="50" width="70" height="60" rx="14" />
            <rect x="330" y="190" width="70" height="60" rx="14" />
          </g>
          <image href="/brand/ai-emblem-144.png" x="180" y="120" width="60" height="60" />
          <g fill="none" stroke="#0A4889" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M44 136h6l3 8-4 2.6a22 22 0 0 0 10 10l2.6-4 8 3.2V162a4 4 0 0 1-4 4A30 30 0 0 1 40 140a4 4 0 0 1 4-4Z" />
            <path d="m352 80 6 6 12-12" />
            <circle cx="358" cy="212" r="7" /><path d="M346 236a12 12 0 0 1 24 0" />
          </g>
          <g font-family="Inter, system-ui, sans-serif" font-size="12" fill="#3B4A5E" text-anchor="middle">
            <text x="55" y="205">Caller</text>
            <text x="210" y="212">AI agent</text>
            <text x="365" y="128">Routine</text>
            <text x="365" y="268">Your team</text>
          </g>
          <circle cx="170" cy="150" r="4" fill="#EDBF0C" /><circle cx="330" cy="80" r="4" fill="#EDBF0C" /><circle cx="330" cy="220" r="4" fill="#EDBF0C" />
        </svg>
      </div>
      <div class="human__copy">
        <SectionHeading id="human-title" eyebrow={humanSupport.eyebrow} title={humanSupport.title} intro={humanSupport.text} />
        <ul class="check-list">
          {humanSupport.points.map((p) => <li><Icon name="checkCircle" size={22} /><span>{p}</span></li>)}
        </ul>
        <p class="human__parent">{humanSupport.parent}</p>
      </div>
    </div>
  </section>

  <!-- F: Demo request -->
  <DemoRequest />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 75% at 80% 30%, rgba(10, 72, 137, 0.6), transparent 70%),
      radial-gradient(ellipse 40% 50% at 0% 100%, rgba(10, 72, 137, 0.25), transparent 70%),
      var(--brand-navy);
    padding-block: clamp(3.5rem, 2rem + 6vw, 8rem) clamp(4rem, 2rem + 6vw, 8.5rem);
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .hero__line { display: block; }
  .hero__line--accent { color: var(--brand-gold); }
  .hero__text { max-width: 54ch; margin-top: var(--space-5); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-5);
  }
  .services-grid > :global(*) { grid-column: span 2; }
  .services-grid > :global(:nth-child(4)) { grid-column: 2 / span 2; }
  .services-grid > :global(:nth-child(5)) { grid-column: 4 / span 2; }
  .services-note { margin-top: var(--space-6); max-width: 760px; }

  .convo-section {
    overflow: hidden;
    background:
      radial-gradient(ellipse 50% 80% at 100% 50%, rgba(10, 72, 137, 0.45), transparent 70%),
      var(--brand-navy);
  }
  .convo-section__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .convo-points { list-style: none; display: grid; gap: var(--space-5); }
  .convo-points li { display: flex; gap: var(--space-4); }
  .convo-points h3 { font-size: var(--text-base); margin-bottom: 2px; }
  .convo-points p { font-size: var(--text-sm); }
  .convo-points__icon {
    flex: none;
    display: grid; place-items: center;
    width: 44px; height: 44px;
    border-radius: 10px;
    border: 1px solid rgba(237, 191, 12, 0.3);
    background: rgba(237, 191, 12, 0.06);
    color: var(--brand-gold);
  }

  /* Flex-wrap so an uneven last row (e.g. 4 + 3) stays centred and balanced */
  .industries {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
  .industry {
    flex: 0 1 calc((100% - 3 * var(--space-4)) / 4);
    min-width: 0;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-light);
    background: var(--warm-white);
  }
  .industry__icon {
    display: grid; place-items: center;
    width: 46px; height: 46px;
    border-radius: 50%;
    background: var(--brand-navy);
    color: var(--brand-gold);
    margin-bottom: var(--space-4);
  }
  .industry h3 { font-size: var(--text-base); }
  .industry p { font-size: var(--text-sm); }
  .industry__label { font-weight: 600; color: var(--brand-blue); }

  .human {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .human__diagram {
    background: var(--white);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    box-shadow: var(--shadow);
  }
  .human__parent {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line-light);
    font-weight: 550;
    color: var(--ink);
  }

  @media (max-width: 1024px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .services-grid > :global(*),
    .services-grid > :global(:nth-child(4)),
    .services-grid > :global(:nth-child(5)) { grid-column: auto; }
  }
  @media (max-width: 900px) {
    .hero__inner, .convo-section__inner, .human { grid-template-columns: 1fr; }
    .hero__visual { max-width: 460px; width: 100%; margin-inline: auto; }
    .human__diagram { order: 2; }
  }
  @media (max-width: 900px) {
    .industry { flex-basis: calc((100% - var(--space-4)) / 2); }
  }
  @media (max-width: 640px) {
    .services-grid { grid-template-columns: 1fr; }
    .industry { flex-basis: 100%; }
    .hero__actions :global(.btn) { width: 100%; }
  }
</style>
